{
    "name": "different/dwfw",
    "description": "Different Development Web FrameWork",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Kukel Attila",
            "email": "kukel.attila@different.hu"
        }
    ],
    "keywords": [
        "framework",
        "laravel",
        "backpack",
        "different"
    ],
    "minimum-stability": "stable",
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "require": {
        "php": "^8.1",
        "backpack/crud": "^6.0",
        "backpack/pro": "^2.0",
        "backpack/filemanager": "^3.0",
        "backpack/permissionmanager": "^7.0",
        "backpack/settings": "^3.1",
        "guzzlehttp/guzzle": "^7.5",
        "intervention/image": "^3.0",
        "jenssegers/agent": "^2.6",
        "laravel/framework": "^10.0",
        "spatie/laravel-honeypot": "^4.0",
        "spatie/laravel-permission": "^6.0"
    },
    "require-dev": {
        "backpack/generators": "^4.0",
        "laracasts/generators": "^2.0",
        "laravel/tinker": "^2.9",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^7.0",
        "phpunit/phpunit": "^10.0",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Different\\Dwfw\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Different\\Dwfw\\Tests\\": "tests"
        },
        "exclude-from-classmap": [
            "**/config"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Different\\Dwfw\\DwfwServiceProvider"
            ]
        }
    },
    "scripts": {
        "post-update-cmd": [
            "@php artisan dwfw:upgrade --ansi"
        ]
    }
}
